# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas (users, favourites, watch history, watch progress)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Authentication
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_EXPIRY=10d

# TMDB (v4 read access token, never exposed to the frontend)
TMDB_ACCESS_TOKEN=replace-with-your-tmdb-read-access-token

# Optional TMDB overrides
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/
TMDB_LANGUAGE=en-US
